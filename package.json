{
  "name": "gnls",
  "publisher": "msedge-dev",
  "version": "0.1.4",
  "displayName": "GN Language Server",
  "description": "Code IntelliSense for GN build system.",
  "license": "SEE LICENSE IN LICENSE",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "gn",
    "chromium"
  ],
  "homepage": "https://github.com/microsoft/gnls",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/gnls.git"
  },
  "bugs": {
    "url": "https://github.com/microsoft/gnls/issues"
  },
  "main": "./build/index.js",
  "engines": {
    "vscode": "^1.83.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gn",
        "aliases": [
          "GN",
          "gn"
        ],
        "extensions": [
          "gn",
          "gni"
        ],
        "configuration": "./build/language.json"
      }
    ],
    "grammars": [
      {
        "language": "gn",
        "scopeName": "source.gn",
        "path": "./build/grammar.json"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.5.0",
    "eslint": "9.28.0",
    "jest": "^30.0.0",
    "jiti": "^2.4.2",
    "node-addon-api": "^8.3.1",
    "node-gyp": "^11.2.0",
    "prettier": "^3.5.3",
    "rollup": "^4.42.0",
    "ts-jest": "^29.3.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "scripts": {
    "prepare": "jiti script prepare",
    "build": "jiti script build",
    "debug": "jiti script debug",
    "test": "jiti script test",
    "format": "jiti script format",
    "package": "jiti script package"
  }
}
